{
  "manifest_version": 3,
  "name": "DeepSeek Desktop Memory",
  "description": "Local long-term memory for the embedded DeepSeek Chat surface.",
  "version": "1.0.0",
  "key": "",
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
