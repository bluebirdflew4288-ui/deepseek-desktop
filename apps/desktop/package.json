{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "DeepSeek Desktop application with tray-owned Host lifecycle",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test:electron": "pnpm --workspace-root run build:lib && pnpm run build && vitest run --root ../.. apps/desktop/tests/deepseek-memory.electron.spec.ts apps/desktop/tests/dual-mode.electron.spec.ts",
    "dev": "pnpm --workspace-root run build && electron .",
    "materialize:electron": "node node_modules/electron/install.js",
    "stage:npm": "node --import tsx scripts/stage-npm.ts",
    "package": "pnpm --workspace-root run build && node --import tsx scripts/stage-npm.ts && pnpm run materialize:electron && electron-builder --dir",
    "dist": "pnpm --workspace-root run build && node --import tsx scripts/stage-npm.ts && pnpm run materialize:electron && electron-builder",
    "dist:mac": "node --import tsx scripts/release-mac.ts",
    "dist:win": "pnpm --workspace-root run build && node --import tsx scripts/stage-npm.ts && pnpm run materialize:electron && electron-builder --win nsis zip --x64 --publish never"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Desktop",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "./scripts/verify-packaged-runtime.ts",
    "asar": true,
    "artifactName": "DeepSeek-Desktop-${version}-${os}-${arch}.${ext}",
    "asarUnpack": [
      "lib/shell-preload.cjs",
      "lib/mode-chrome-preload.cjs",
      "lib/harness-theme-preload.cjs",
      "lib/chat-theme-preload.cjs"
    ],
    "files": [
      "lib/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "desktop-resources"
      },
      {
        "from": "build/zh_CN.lproj",
        "to": "zh_CN.lproj"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "icon": "build/icon.png",
      "identity": "-",
      "notarize": true,
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
